---
import { siteConfig } from '../../config/site';
import { navigationConfig } from '../../config/navigation';
import Container from '../ui/Container.astro';

const currentYear = new Date().getFullYear();
const { product, resources, legal } = navigationConfig.footer;
---

<footer class="footer">
  <Container size="xl">
    <!-- Mandatory Risk & Educational Disclaimer Banner -->
    <div class="footer__disclaimer" role="note" aria-label="Educational risk disclaimer">
      <p>
        <strong>Educational checklist, not financial advice:</strong> Crypto Made Easy does not
        predict prices, connect to exchanges, or execute trades. All worked price examples are
        historical or synthetic illustrations. Always set a pre-planned stop-loss and never risk
        capital you cannot afford to lose.
      </p>
    </div>

    <div class="footer__grid">
      <!-- Brand & Summary Column -->
      <div class="footer__brand-col">
        <a href="/" class="footer__brand" aria-label={`${siteConfig.name} Home`}>
          <span class="footer__brand-name">{siteConfig.name}</span>
        </a>
        <p class="footer__tagline">{siteConfig.description}</p>
      </div>

      <!-- Navigation Columns -->
      <div class="footer__nav-col">
        <h3 class="footer__heading">Platform</h3>
        <ul class="footer__list">
          {product.map((item) => (
            <li>
              <a href={item.href} class="footer__link">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__nav-col">
        <h3 class="footer__heading">Core Method</h3>
        <ul class="footer__list">
          {resources.map((item) => (
            <li>
              <a
                href={item.href}
                class="footer__link"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div class="footer__nav-col">
        <h3 class="footer__heading">Disclosures</h3>
        <ul class="footer__list">
          {legal.map((item) => (
            <li>
              <a
                href={item.href}
                class="footer__link"
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer__bottom">
      <p class="footer__copyright">
        &copy; {currentYear} {siteConfig.author.name}. Stateless &amp; private: Signal Checker
        inputs never leave your browser.
      </p>
      <div class="footer__socials">
        {siteConfig.socials.github && (
          <a
            href={siteConfig.socials.github}
            class="footer__social-link"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="GitHub Repository"
          >
            GitHub
          </a>
        )}
      </div>
    </div>
  </Container>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--color-border-default);
    background-color: var(--color-bg-surface);
    padding-top: var(--space-8);
    padding-bottom: var(--space-8);
    margin-top: auto;
  }

  .footer__disclaimer {
    background-color: var(--color-bg-canvas);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    padding: var(--space-3) var(--space-4);
    margin-bottom: var(--space-8);
  }

  .footer__disclaimer p {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    line-height: var(--line-height-normal);
  }

  .footer__disclaimer strong {
    color: var(--color-text-main);
    font-weight: var(--font-weight-semibold);
  }

  .footer__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
  }

  @media (min-width: 640px) {
    .footer__grid {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  @media (min-width: 1024px) {
    .footer__grid {
      grid-template-columns: 2fr 1fr 1fr 1fr;
      gap: var(--space-10);
    }
  }

  .footer__brand-col {
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__brand {
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-main);
    text-decoration: none;
  }

  .footer__tagline {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    max-width: 44ch;
  }

  .footer__heading {
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-main);
    margin-bottom: var(--space-3);
  }

  .footer__list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
  }

  .footer__link {
    font-size: var(--font-size-sm);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer__link:hover {
    color: var(--color-text-main);
    text-decoration: underline;
  }

  .footer__bottom {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-8);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-border-subtle);
  }

  @media (min-width: 640px) {
    .footer__bottom {
      flex-direction: row;
      align-items: center;
    }
  }

  .footer__copyright {
    font-size: var(--font-size-xs);
    color: var(--color-text-subtle);
  }

  .footer__social-link {
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    text-decoration: none;
  }

  .footer__social-link:hover {
    color: var(--color-text-main);
    text-decoration: underline;
  }
</style>
