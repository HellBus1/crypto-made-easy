---
import { siteConfig } from '../../config/site';
import { navigationConfig } from '../../config/navigation';
import Container from '../ui/Container.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';

const currentPath = Astro.url.pathname;
const navItems = navigationConfig.header;

function isActive(href: string): boolean {
  if (href === '/') {
    return currentPath === '/';
  }
  return currentPath.startsWith(href);
}
---

<header class="header">
  <Container size="xl">
    <div class="header__inner">
      <!-- Site Branding -->
      <a href="/" class="header__brand" aria-label={`${siteConfig.name} Home`}>
        <svg
          class="header__logo-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <line x1="7" y1="3" x2="7" y2="21"></line>
          <rect x="4.5" y="7" width="5" height="9" rx="1" fill="currentColor"></rect>
          <line x1="17" y1="4" x2="17" y2="20"></line>
          <rect
            x="14.5"
            y="8"
            width="5"
            height="7"
            rx="1"
            fill="var(--color-bg-surface)"
            stroke="currentColor"
          ></rect>
        </svg>
        <span class="header__brand-name">{siteConfig.name}</span>
        <span class="header__scope-badge">Beginner Guide</span>
      </a>

      <!-- Desktop Navigation Links -->
      <nav class="header__nav" aria-label="Main Navigation">
        <ul class="header__nav-list">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'header__nav-link',
                  isActive(item.href) ? 'header__nav-link--active' : '',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <!-- Actions: Progress Pill, Primary CTA, Theme Toggle & Mobile Menu Button -->
      <div class="header__actions">
        <a
          href="/learn/01-how-a-chart-is-built"
          id="header-progress-pill"
          class="header__progress-pill"
          title="Your local course progress"
        >
          <span class="header__progress-dot" aria-hidden="true"></span>
          <span id="header-progress-text" class="num">
            0/8 Done
          </span>
        </a>

        <a href="/checker" class="header__cta">
          {' '}
          Check a Coin{' '}
        </a>
        <ThemeToggle />

        <button
          type="button"
          id="mobile-menu-toggle"
          class="header__mobile-toggle"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Toggle navigation menu"
        >
          <svg
            class="header__menu-icon icon-open"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <line x1="4" x2="20" y1="12" y2="12"></line>
            <line x1="4" x2="20" y1="6" y2="6"></line>
            <line x1="4" x2="20" y1="18" y2="18"></line>
          </svg>
          <svg
            class="header__menu-icon icon-close"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M18 6 6 18"></path>
            <path d="m6 6 12 12"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Drawer Menu -->
    <div id="mobile-menu" class="header__mobile-menu" hidden>
      <nav aria-label="Mobile Navigation">
        <ul class="header__mobile-list">
          {navItems.map((item) => (
            <li>
              <a
                href={item.href}
                class:list={[
                  'header__mobile-link',
                  isActive(item.href) ? 'header__mobile-link--active' : '',
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))}
          <li class="header__mobile-cta-item">
            <a href="/checker" class="btn-primary" style="width: 100%; margin-top: 4px;">
              Open 3-Light Signal Checker
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </Container>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background-color: var(--color-bg-surface);
    border-bottom: 1px solid var(--color-border-default);
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 3.75rem;
    gap: var(--space-3);
  }

  .header__brand {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    font-size: var(--font-size-base);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    text-decoration: none;
    flex-shrink: 0;
  }

  .header__brand:hover {
    color: var(--color-text-main);
    text-decoration: none;
  }

  .header__logo-icon {
    width: 1.35rem;
    height: 1.35rem;
    color: var(--color-data-hue);
  }

  .header__scope-badge {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-data-hue);
    background-color: var(--color-data-hue-subtle);
    border: 1px solid var(--color-pill-info-border);
    padding: 2px var(--space-2);
    border-radius: var(--radius-sm);
    display: none;
  }

  @media (min-width: 900px) {
    .header__scope-badge {
      display: inline-block;
    }
  }

  .header__nav {
    display: none;
  }

  @media (min-width: 768px) {
    .header__nav {
      display: block;
    }
  }

  .header__nav-list {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    list-style: none;
  }

  .header__nav-link {
    display: inline-block;
    padding: 6px var(--space-3);
    border-radius: var(--radius-md);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    text-decoration: none;
    transition:
      background-color var(--transition-fast),
      color var(--transition-fast);
  }

  .header__nav-link:hover {
    color: var(--color-text-main);
    background-color: var(--color-bg-subtle);
    text-decoration: none;
  }

  .header__nav-link--active {
    color: var(--color-text-main);
    background-color: var(--color-bg-subtle);
    font-weight: var(--font-weight-bold);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .header__progress-pill {
    display: none;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: var(--radius-full);
    border: 1px solid var(--color-border-default);
    background-color: var(--color-bg-subtle);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-main);
    text-decoration: none;
  }

  .header__progress-pill:hover {
    border-color: var(--color-data-hue);
    background-color: var(--color-data-hue-subtle);
    text-decoration: none;
  }

  @media (min-width: 640px) {
    .header__progress-pill {
      display: inline-flex;
    }
  }

  .header__progress-dot {
    width: 7px;
    height: 7px;
    border-radius: 9999px;
    background-color: var(--color-success);
  }

  .header__cta {
    display: none;
    align-items: center;
    justify-content: center;
    height: 2.15rem;
    padding-inline: var(--space-3);
    background-color: var(--color-brand-primary);
    color: var(--color-brand-primary-text);
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-semibold);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .header__cta:hover {
    background-color: var(--color-brand-primary-hover);
    color: var(--color-brand-primary-text);
    text-decoration: none;
  }

  @media (min-width: 640px) {
    .header__cta {
      display: inline-flex;
    }
  }

  .header__mobile-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: var(--space-1);
    background: transparent;
    color: var(--color-text-main);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    cursor: pointer;
  }

  .header__mobile-toggle:hover {
    background-color: var(--color-bg-subtle);
  }

  .header__menu-icon {
    width: 1.25rem;
    height: 1.25rem;
  }

  .icon-close {
    display: none;
  }

  .header__mobile-toggle[aria-expanded='true'] .icon-open {
    display: none;
  }

  .header__mobile-toggle[aria-expanded='true'] .icon-close {
    display: block;
  }

  @media (min-width: 768px) {
    .header__mobile-toggle {
      display: none;
    }
  }

  /* Mobile Dropdown Menu */
  .header__mobile-menu {
    border-top: 1px solid var(--color-border-subtle);
    padding-block: var(--space-3);
  }

  .header__mobile-menu[hidden] {
    display: none;
  }

  .header__mobile-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    list-style: none;
  }

  .header__mobile-link {
    display: block;
    padding: var(--space-2) var(--space-3);
    font-size: var(--font-size-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text-muted);
    border-radius: var(--radius-md);
    text-decoration: none;
  }

  .header__mobile-link:hover {
    background-color: var(--color-bg-subtle);
    color: var(--color-text-main);
    text-decoration: none;
  }

  .header__mobile-link--active {
    color: var(--color-text-main);
    background-color: var(--color-bg-subtle);
    font-weight: var(--font-weight-bold);
  }

  @media (min-width: 768px) {
    .header__mobile-menu {
      display: none !important;
    }
  }
</style>

<script>
  function setupHeader() {
    const toggle = document.getElementById('mobile-menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const progressText = document.getElementById('header-progress-text');

    function updateHeaderProgress() {
      if (!progressText) return;
      try {
        const raw = window.localStorage.getItem('cme:v1');
        if (!raw) {
          progressText.textContent = '0/8 Done';
          return;
        }
        const parsed = JSON.parse(raw);
        const count = Array.isArray(parsed?.completed) ? parsed.completed.length : 0;
        progressText.textContent = `${Math.min(8, count)}/8 Done`;
      } catch {
        progressText.textContent = '0/8 Done';
      }
    }

    updateHeaderProgress();
    window.addEventListener('cme:progress-updated', updateHeaderProgress);
    window.addEventListener('storage', updateHeaderProgress);

    if (!toggle || !menu) return;

    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!isExpanded));
      if (isExpanded) {
        menu.setAttribute('hidden', '');
      } else {
        menu.removeAttribute('hidden');
      }
    });
  }

  setupHeader();
  document.addEventListener('astro:after-swap', setupHeader);
</script>
