---
import type { HTMLTag, Polymorphic } from 'astro/types';

export type Props<Tag extends HTMLTag = 'div'> = Polymorphic<{
  as: Tag;
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full';
  class?: string;
}>;

const { as: Tag = 'div', size = 'xl', class: className = '', ...rest } = Astro.props;
---

<Tag class:list={['container', `container--${size}`, className]} {...rest}>
  <slot />
</Tag>

<style>
  .container {
    width: 100%;
    margin-inline: auto;
    padding-inline: clamp(0.875rem, 2.5vw, 3rem);
  }

  .container--sm {
    max-width: var(--container-sm);
  }

  .container--md {
    max-width: var(--container-md);
  }

  .container--lg {
    max-width: var(--container-lg);
  }

  .container--xl {
    max-width: min(96vw, var(--container-xl));
  }

  @media (min-width: 1920px) {
    .container--xl {
      max-width: min(94vw, var(--container-2xl));
    }
  }

  .container--full {
    max-width: 100%;
  }
</style>
