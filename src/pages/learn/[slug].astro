---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/ui/Container.astro';
import CourseSidebar from '../../components/learn/CourseSidebar';
import ChapterProgress from '../../components/learn/ChapterProgress';
import ChapterComplete from '../../components/learn/ChapterComplete';
import { curriculum } from '../../config/curriculum';

export async function getStaticPaths() {
  const lessons = await getCollection('lessons', ({ data }) => {
    return import.meta.env.PROD ? !data.draft : true;
  });

  return lessons.map((lesson) => ({
    params: { slug: lesson.id },
    props: { lesson },
  }));
}

const { lesson } = Astro.props;
const { Content, headings } = await render(lesson);
const meta = curriculum.find((c) => c.slug === lesson.id);
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

<BaseLayout
  title={`Chapter ${lesson.data.chapter}: ${lesson.data.title}`}
  description={lesson.data.description}
>
  <Container size="xl">
    <div class="course-shell course-shell--with-rail">
      <!-- Left Column: Curriculum & Progress Sidebar -->
      <div class="course-sidebar-wrap">
        <CourseSidebar client:load currentSlug={lesson.id} />
      </div>

      <!-- Center Column: Main Lesson Article & Interactive Labs -->
      <article class="course-main surface-card lesson-article">
        <ChapterProgress
          client:load
          chapter={lesson.data.chapter}
          slug={lesson.id}
          track={lesson.data.track}
          durationMinutes={meta?.durationMinutes ?? 6}
        />

        <header class="lesson-header">
          <h1>
            Chapter {lesson.data.chapter}: {lesson.data.title}
          </h1>
          <p class="lesson-description">{lesson.data.description}</p>
        </header>

        {(lesson.data.goals.length > 0 || lesson.data.realWorldWhy) && (
          <section
            class="lesson-goals-card"
            aria-label="Chapter Goals and Real-World Purpose"
            data-testid="lesson-goals-card"
          >
            {lesson.data.realWorldWhy && (
              <div class="lesson-goals-why">
                <span class="status-pill status-pill--info">Why This Matters in Real Life</span>
                <p>{lesson.data.realWorldWhy}</p>
              </div>
            )}
            {lesson.data.goals.length > 0 && (
              <div class="lesson-goals-list-wrap">
                <div class="lesson-goals-title">Chapter {lesson.data.chapter} Practical Goals:</div>
                <ul class="lesson-goals-list">
                  {lesson.data.goals.map((goal) => (
                    <li>{goal}</li>
                  ))}
                </ul>
              </div>
            )}
          </section>
        )}

        <div class="prose lesson-prose">
          <Content />
        </div>

        <ChapterComplete
          client:load
          slug={lesson.id}
          chapter={lesson.data.chapter}
          title={lesson.data.title}
        />
      </article>

      <!-- Right Column (Visible on Large Screens >= 1440px): On-Page Guide & 4 Essentials Cheat Card -->
      <aside class="course-rail-wrap" aria-label="On this page and quick reference">
        <div class="rail-card">
          <div class="rail-card__title">On This Page</div>
          <ul class="rail-toc">
            {tocHeadings.map((h) => (
              <li class={h.depth === 3 ? 'rail-toc__sub' : ''}>
                <a href={`#${h.slug}`}>{h.text}</a>
              </li>
            ))}
            <li>
              <a href={`#chapter-quiz-${lesson.data.chapter}`}>Take Chapter Quiz &darr;</a>
            </li>
            <li>
              <a href="#chapter-complete-box">Mark Chapter Complete &darr;</a>
            </li>
          </ul>
        </div>

        <div class="rail-card">
          <div class="rail-card__title">4 Beginner Essentials Cheat-Card</div>
          <ul class="rail-essentials">
            <li>
              <strong>1. Timeframe:</strong> Click <code>4h</code> or <code>1D</code> (skip{' '}
              <code>1m</code> noise).
            </li>
            <li>
              <strong>2. Light 1 (MA / BOLL):</strong> Price below <code>MA30</code> or near{' '}
              <code>BOLL LB</code> = on discount.
            </li>
            <li>
              <strong>3. Light 2 (RSI):</strong> <code>RSI &le; 38</code> = sellers are tired.
            </li>
            <li>
              <strong>4. Light 3 (Order Book):</strong> <code>&ge; 40%</code> Green Buyers waiting
              below.
            </li>
          </ul>
          <a href="/checker" class="btn-primary" style="width: 100%; margin-top: 12px;">
            Open 3-Light Signal Helper &rarr;
          </a>
          <a href="/journal" class="btn-secondary" style="width: 100%; margin-top: 8px;">
            Log a Paper Check &rarr;
          </a>
        </div>
      </aside>
    </div>
  </Container>
</BaseLayout>

<style>
  .lesson-article {
    padding: var(--space-4);
  }

  @media (min-width: 640px) {
    .lesson-article {
      padding: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .lesson-article {
      padding: var(--space-8);
    }
  }

  .lesson-header {
    padding-bottom: var(--space-5);
    margin-bottom: var(--space-6);
    border-bottom: 1px solid var(--color-border-default);
  }

  .lesson-header h1 {
    margin-bottom: var(--space-2);
  }

  .lesson-description {
    font-size: var(--font-size-base);
    color: var(--color-text-muted);
    max-width: 90ch;
    margin: 0;
  }

  .lesson-prose {
    max-width: 100%;
  }

  .rail-card {
    padding: var(--space-4);
    border-radius: var(--radius-lg);
    border: 1px solid var(--color-border-default);
    background-color: var(--color-bg-surface);
    margin-bottom: var(--space-4);
  }

  .rail-card__title {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-main);
    margin-bottom: var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .rail-toc {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: var(--font-size-xs);
  }

  .rail-toc a {
    color: var(--color-text-muted);
    text-decoration: none;
    line-height: 1.4;
    display: block;
    padding: 3px 0;
  }

  .rail-toc a:hover {
    color: var(--color-data-hue);
    text-decoration: underline;
  }

  .rail-toc__sub {
    padding-left: var(--space-3);
  }

  .rail-essentials {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--space-2);
    font-size: var(--font-size-xs);
    line-height: 1.45;
    color: var(--color-text-muted);
  }

  .rail-essentials strong {
    color: var(--color-text-main);
  }

  .lesson-goals-card {
    padding: var(--space-4) var(--space-5);
    margin-bottom: var(--space-6);
    border-radius: var(--radius-lg);
    background-color: var(--color-bg-canvas);
    border: 1px solid var(--color-border-default);
    border-left: 4px solid var(--color-data-hue);
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .lesson-goals-why p {
    margin: 6px 0 0 0;
    font-size: var(--font-size-sm);
    color: var(--color-text-main);
    line-height: 1.55;
  }

  .lesson-goals-title {
    font-size: var(--font-size-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-data-hue);
    margin-bottom: 4px;
  }

  .lesson-goals-list {
    margin: 0;
    padding-left: var(--space-5);
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
