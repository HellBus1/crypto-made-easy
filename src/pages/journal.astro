---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/ui/Container.astro';
import PaperJournal from '../components/journal/PaperJournal';
---

<BaseLayout
  title="Paper-Trade Journal & 10-Check Graduation Drill"
  description="Practice 10 calm 4H/1D paper-trade checks and verify all safety rules before placing your first <$50 spot order on Gate.com."
>
  <section class="journal-page">
    <Container size="xl">
      <div class="surface-card journal-hero">
        <div class="journal-hero__top">
          <div>
            <span class="status-pill status-pill--info">
              Paper Practice Drill · Separate Browser Storage
            </span>
            <h1 style="margin-top: 8px; margin-bottom: 6px;">
              Paper-Trade Journal &amp; &lt;$50 Readiness Tracker
            </h1>
            <p class="text-muted" style="margin: 0; max-width: 68ch;">
              Knowledge from lessons alone creates the Valedictorian Trap. Log 10 calm,
              rule-compliant paper checks here &mdash; including checks where you wisely skipped a
              trade &mdash; before risking real money on Gate.com.
            </p>
          </div>
          <a href="/checker" class="btn-secondary">
            {' '}
            Open 3-Light Signal Checker &rarr;{' '}
          </a>
        </div>
      </div>

      <PaperJournal client:load />

      <div class="journal-disclaimer" role="note">
        <strong>Educational Notice:</strong> This paper-trade journal stores entries only inside
        your own browser (<code>cme:journal:v1</code>) and keeps the 3-Light Signal Checker strictly
        stateless. Paper trading simulates discipline; real exchange fills also depend on liquidity
        and 0.2% spot fees.
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  .journal-page {
    padding-block: var(--space-8);
  }

  .journal-hero__top {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
  }

  .journal-disclaimer {
    margin-top: var(--space-5);
    padding: var(--space-3) var(--space-4);
    border-radius: var(--radius-md);
    background-color: var(--color-bg-subtle);
    border: 1px solid var(--color-border-default);
    font-size: var(--font-size-xs);
    color: var(--color-text-muted);
    line-height: 1.5;
  }
</style>
